#!/usr/bin/python
"""wox - WiamOX terminal helper.  `wox why`: explain the last failed command
with the local model (llama-server, started from the AI Center)."""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

URL = os.environ.get("WOX_LLAMA_URL", "http://127.0.0.1:8080").rstrip("/")
MAX_CHARS = 6000
RERUN_TIMEOUT = 30

SYSTEM = (
    "You are the terminal assistant of WiamOX, an Arch Linux based distro "
    "(pacman, systemd, niri/zsh). The user ran a command and it failed. "
    "Explain briefly and concretely WHY it failed, then give numbered fix "
    "steps with the exact commands in code blocks. Prefer pacman over other "
    "package managers; mention sudo only when really needed. If the output "
    "is not enough to be sure, say what to check next. No long introductions. "
    "Reply in the language of this locale: {lang}."
)

REDACT = [
    (re.compile(r"(?i)\b([A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD)[A-Z0-9_]*)=\S+"), r"\1=<redacted>"),
    (re.compile(r"(?i)(authorization:\s*bearer\s+)\S+"), r"\1<redacted>"),
    (re.compile(r"(://[^/\s:@]+:)[^@\s/]+@"), r"\1<redacted>@"),
    (re.compile(r"\b(?:sk|ghp|gho|github_pat|hf|xox[bap])[-_][A-Za-z0-9_\-]{16,}"), "<redacted>"),
    (re.compile(r"(?i)(--(?:password|token|api-key)[= ])\S+"), r"\1<redacted>"),
]


def redact(text):
    for rx, rep in REDACT:
        text = rx.sub(rep, text)
    return text


def state_dir():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/wox-{os.getuid()}", "wox")


def read_failures(session):
    """(entries newest first, current seq) from the hook's files."""
    if not session:
        return [], 0
    d = state_dir()
    try:
        seq = int(open(os.path.join(d, f"{session}.seq")).read().strip() or 0)
    except (OSError, ValueError):
        seq = 0
    out = []
    try:
        for line in open(os.path.join(d, f"{session}.log"), encoding="utf-8", errors="replace"):
            p = line.rstrip("\n").split("\t", 4)
            if len(p) == 5 and p[0].isdigit() and p[1].lstrip("-").isdigit() and p[2].isdigit():
                out.append({"t": int(p[0]), "rc": int(p[1]), "seq": int(p[2]), "cwd": p[3], "cmd": p[4]})
    except OSError:
        pass
    out = [e for e in out if time.time() - e["t"] < 3600]
    return sorted(out, key=lambda e: -e["seq"]), seq


def server_state():
    """'ok' | 'loading' | 'down'"""
    try:
        with urllib.request.urlopen(URL + "/health", timeout=2) as r:
            return "ok" if r.status == 200 else "loading"
    except urllib.error.HTTPError as e:
        return "loading" if e.code == 503 else "down"
    except Exception:
        return "down"


def ask(prompt, default=""):
    try:
        return input(prompt).strip().lower() or default
    except EOFError:
        return "q"


def ago(t):
    s = int(time.time() - t)
    return f"{s}s ago" if s < 90 else f"{s // 60} min ago"


def tail(text):
    lines = text.strip().splitlines()[-120:]
    text = "\n".join(lines)
    return text[-MAX_CHARS:]


def paste_mode():
    print("Paste the error text, then press Ctrl-D on an empty line:")
    try:
        data = sys.stdin.read()
    except KeyboardInterrupt:
        return ""
    return data


def rerun(entry):
    cwd = entry["cwd"] if os.path.isdir(entry["cwd"]) else None
    shell = os.environ.get("SHELL") or "/bin/sh"
    print(f"Running again (max {RERUN_TIMEOUT}s, no input)...")
    try:
        r = subprocess.run([shell, "-c", entry["cmd"]], cwd=cwd, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=RERUN_TIMEOUT)
        return r.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired as e:
        return (e.stdout or b"").decode("utf-8", "replace") + "\n[timed out]"
    except OSError as e:
        return f"[could not run: {e}]"


def tmux_screen():
    if not os.environ.get("TMUX") or not shutil.which("tmux"):
        return ""
    r = subprocess.run(["tmux", "capture-pane", "-p", "-S", "-200"], capture_output=True, text=True)
    return r.stdout


def choose_entry(entries, seq):
    """Returns an entry dict, None for 'paste', or False to quit."""
    if not entries:
        print("No failed command recorded in this terminal in the last hour.")
        return None if ask("Paste an error instead? [Y/n] ", "y") == "y" else False
    latest = entries[0]
    if latest["seq"] == seq:
        print(f"Last command failed (exit {latest['rc']}):  {latest['cmd']}")
        return latest
    print("Recent failed commands in this terminal:")
    shown = entries[:5]
    for i, e in enumerate(shown, 1):
        print(f"  {i}) {e['cmd'][:70]}   (exit {e['rc']}, {ago(e['t'])})")
    print("  p) paste an error text     q) quit")
    while True:
        a = ask(f"Which one? [1-{len(shown)}/p/q] ", "1")
        if a == "q":
            return False
        if a == "p":
            return None
        if a.isdigit() and 1 <= int(a) <= len(shown):
            return shown[int(a) - 1]


def get_error(entry):
    """Returns (command, output) or None to abort."""
    if entry is None:
        text = paste_mode()
        return ("(pasted by user)", text) if text.strip() else None
    opts = "[r] run it again to capture the error   [p] paste the error text"
    keys = "r/p"
    if os.environ.get("TMUX"):
        opts += "   [t] take the tmux screen"
        keys += "/t"
    print(opts + "   [q] quit")
    while True:
        a = ask(f"How should I get the error text? [{keys}/q] ", "r")
        if a == "q":
            return None
        if a == "r":
            return entry["cmd"], rerun(entry)
        if a == "p":
            text = paste_mode()
            return (entry["cmd"], text) if text.strip() else None
        if a == "t" and "t" in keys:
            return entry["cmd"], tmux_screen()


def explain(cmd, output, rc=None):
    lang = os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en_US.UTF-8"
    user = f"Command: {cmd}\n"
    if rc is not None:
        user += f"Exit code: {rc}\n"
    user += f"Directory: {os.getcwd()}\n\nOutput:\n```\n{redact(tail(output))}\n```\n\nPlease explain this error to me and what the fixing suggestions are."
    body = {"messages": [{"role": "system", "content": SYSTEM.format(lang=lang)},
                         {"role": "user", "content": user}],
            "stream": True, "temperature": 0.3, "max_tokens": 1500}
    req = urllib.request.Request(URL + "/v1/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    print("\n\033[2mThinking...\033[0m", end="", flush=True)
    started = False
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    delta = json.loads(data)["choices"][0]["delta"].get("content") or ""
                except (ValueError, KeyError, IndexError):
                    continue
                if delta and not started:
                    started = True
                    print("\r\033[K", end="")
                print(delta, end="", flush=True)
    except KeyboardInterrupt:
        print("\n(stopped)")
        return 130
    except (urllib.error.URLError, OSError) as e:
        print(f"\r\033[K\nThe model server did not answer: {e}")
        return 1
    print("\r\033[K" if not started else "")
    return 0


def cmd_why(args):
    paste = "-p" in args or "--paste" in args
    state = server_state()
    if state == "down":
        print("The local AI is not running. Start the AI Center first:\n"
              "  wiamox-ai-center   ->  llama.cpp  ->  pick a model  ->  Start server")
        return 1
    if state == "loading":
        print("The AI server is still loading the model. Try again in a few seconds.")
        return 1

    if not sys.stdin.isatty():          # command 2>&1 | wox why
        text = sys.stdin.read()
        if not text.strip():
            print("Nothing on stdin.")
            return 1
        return explain("(piped output)", text)

    if paste:
        got = get_error(None)
        entry = None
    else:
        entries, seq = read_failures(os.environ.get("WOX_SESSION"))
        entry = choose_entry(entries, seq)
        if entry is False:
            return 0
        got = get_error(entry)
    if not got:
        return 0
    cmd, out = got
    if not out.strip():
        print("There was no output to explain (the command may have failed silently).")
        return 1
    return explain(cmd, out, entry["rc"] if entry else None)


# Package commands: thin pacman wrappers. The real command is printed first,
# so users learn pacman while they use wox. Extra flags are passed through.

def sudo():
    return [] if os.geteuid() == 0 else ["sudo"]


def run(cmd):
    dim, off = ("\033[2m", "\033[0m") if sys.stdout.isatty() else ("", "")
    print(f"{dim}-> {' '.join(cmd)}{off}", flush=True)
    try:
        return subprocess.run(cmd).returncode
    except FileNotFoundError as e:
        print(f"wox: {e.filename} not found")
        return 127


def need_args(args, verb, what="package"):
    if args:
        return True
    print(f"wox {verb}: name at least one {what}, e.g.  wox {verb} firefox")
    return False


def is_installed(pkg):
    return subprocess.run(["pacman", "-Qq", pkg], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def cmd_install(args):
    return run(sudo() + ["pacman", "-Sy"] + args) if need_args(args, "install") else 2


def cmd_remove(args):
    return run(sudo() + ["pacman", "-Rns"] + args) if need_args(args, "remove") else 2


def cmd_update(args):
    return run(sudo() + ["pacman", "-Syu"] + args)


def cmd_search(args):
    return run(["pacman", "-Ss"] + args) if need_args(args, "search", "search term") else 2


def cmd_info(args):
    if not need_args(args, "info"):
        return 2
    rc = 0
    for pkg in args:
        rc = run(["pacman", "-Qi" if is_installed(pkg) else "-Si", pkg]) or rc
    return rc


def cmd_list(args):
    return run(["pacman", "-Qe"] + args)


def cmd_clean(args):
    r = subprocess.run(["pacman", "-Qdtq"], capture_output=True, text=True)
    orphans = r.stdout.split()
    if not orphans:
        print("No orphans: every installed dependency is still needed.")
        return 0
    print(f"Orphans (installed as dependency, no longer needed): {' '.join(orphans)}")
    return run(sudo() + ["pacman", "-Rns"] + args + orphans)


# GPU detection and tips (`wox gpu`). Reads sysfs only, so it works offline,
# in the live session and in the installer's chroot. The NVIDIA driver
# branch is chosen from the PCI device ID; the ranges follow NVIDIA's chip
# generations:
#   >= 0x1E00          Turing and newer (GTX 16xx, RTX 20-50) -> new 615 driver
#   0x1340 - 0x1DFF    Maxwell, Pascal, Volta (GTX 750-1080, Titan V) -> legacy 580
#   below 0x1340       Kepler and older -> nouveau (no maintained NVIDIA driver)

SYSFS = os.environ.get("WOX_SYSFS", "/sys")
NVIDIA_SETUP = "/usr/lib/wiamox-nvidia/setup"
NVIDIA_STATE = "/var/lib/wiamox-nvidia/state"
VENDORS = {0x10DE: "NVIDIA", 0x1002: "AMD", 0x8086: "Intel"}
BRANCH_TEXT = {
    "new": "NVIDIA 615 driver (open kernel modules)",
    "legacy": "NVIDIA 580 legacy driver (closed)",
    "nouveau": "nouveau (open source; no maintained NVIDIA driver for this card)",
}


def nvidia_branch(devid):
    if devid >= 0x1E00:
        return "new"
    if devid >= 0x1340:
        return "legacy"
    return "nouveau"


def read_sys(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def gpus():
    """Display controllers (PCI class 0x03xxxx) as dicts."""
    base = os.path.join(SYSFS, "bus/pci/devices")
    out = []
    try:
        addrs = sorted(os.listdir(base))
    except OSError:
        return out
    for addr in addrs:
        d = os.path.join(base, addr)
        cls = read_sys(os.path.join(d, "class"))
        if not cls.startswith("0x03"):
            continue
        try:
            vendor = int(read_sys(os.path.join(d, "vendor")), 16)
            device = int(read_sys(os.path.join(d, "device")), 16)
        except ValueError:
            continue
        drv = os.path.join(d, "driver")
        out.append({"addr": addr, "vendor": vendor, "device": device,
                    "driver": os.path.basename(os.readlink(drv)) if os.path.islink(drv) else "",
                    "boot_vga": read_sys(os.path.join(d, "boot_vga")) == "1"})
    return out


def recommend(found):
    """One branch for all NVIDIA cards: the 580 driver also runs newer
    cards, so a single older card decides."""
    branches = {nvidia_branch(g["device"]) for g in found if g["vendor"] == 0x10DE}
    if not branches:
        return "none"
    for b in ("legacy", "new"):
        if b in branches:
            return b
    return "nouveau"


def gpu_name(addr):
    try:
        r = subprocess.run(["lspci", "-s", addr], capture_output=True, text=True)
        line = r.stdout.strip()
        return line.split(": ", 1)[1] if ": " in line else ""
    except OSError:
        return ""


def installed(*names):
    r = subprocess.run(["pacman", "-Qq", *names], capture_output=True, text=True)
    return r.stdout.split()


def cmd_gpu(args):
    found = gpus()
    rec = recommend(found)
    if args[:1] == ["--recommend"]:
        print(rec)
        return 0
    if args[:1] == ["install"]:
        mode = args[1] if len(args) > 1 else "auto"
        if mode not in ("auto", "new", "legacy"):
            print("wox gpu install: mode is auto, new or legacy")
            return 2
        if not os.access(NVIDIA_SETUP, os.X_OK):
            print("wiamox-nvidia is not installed:  wox install wiamox-nvidia")
            return 1
        return run(sudo() + [NVIDIA_SETUP, "install", mode])
    if args:
        print("usage: wox gpu [--recommend | install [auto|new|legacy]]")
        return 2

    if not found:
        print("No graphics card found in " + os.path.join(SYSFS, "bus/pci/devices") + ".")
        return 1
    print("Graphics cards:")
    for g in found:
        vendor = VENDORS.get(g["vendor"], f"{g['vendor']:04x}")
        name = gpu_name(g["addr"]) or vendor
        drv = g["driver"] or "no driver loaded"
        print(f"  {g['addr']}  {name}")
        print(f"      [{g['vendor']:04x}:{g['device']:04x}]  driver in use: {drv}"
              + ("  (main display)" if g["boot_vga"] else ""))
        if g["vendor"] == 0x10DE:
            print(f"      fits: {BRANCH_TEXT[nvidia_branch(g['device'])]}")

    nv = [g for g in found if g["vendor"] == 0x10DE]
    if not nv:
        print("\nNo NVIDIA card: nothing to install, AMD and Intel use the open Mesa drivers.")
        return 0

    pkgs = installed("nvidia-open-dkms", "nvidia-580xx-dkms", "nvidia-utils", "nvidia-580xx-utils",
                     "lib32-nvidia-utils", "lib32-nvidia-580xx-utils", "linux-headers", "dkms")
    # The loaded module tells the truth; packages only when none is loaded
    # (other distros ship prebuilt module packages instead of DKMS).
    version = read_sys(os.path.join(SYSFS, "module/nvidia/version"))
    if version:
        have = "legacy" if version.split(".")[0] == "580" else "new"
    else:
        have = "new" if "nvidia-open-dkms" in pkgs else "legacy" if "nvidia-580xx-dkms" in pkgs else "nouveau"
    print(f"\nRecommended: {BRANCH_TEXT[rec]}")
    print(f"In use:      {BRANCH_TEXT[have]}" + (f"  (module {version})" if version else ""))
    if pkgs:
        print("             " + " ".join(pkgs))
    loaded = sorted(m for m in ("nvidia", "nvidia_drm", "nvidia_modeset", "nvidia_uvm", "nouveau")
                    if os.path.isdir(os.path.join(SYSFS, "module", m)))
    print("Loaded:      " + (" ".join(loaded) or "no NVIDIA or nouveau module"))
    modeset = read_sys(os.path.join(SYSFS, "module/nvidia_drm/parameters/modeset"))
    if modeset:
        print(f"KMS:         nvidia_drm.modeset={modeset}")
    state = read_sys(NVIDIA_STATE)
    if state:
        print("Installer:   " + state.replace("\n", "\n             "))

    print("\nTips:")
    if have != rec:
        if rec == "nouveau":
            print("  - This card is older than Maxwell (GTX 600/700 or older). NVIDIA no longer\n"
                  "    maintains a driver for it; WiamOX uses nouveau. Remove the NVIDIA driver:\n"
                  "    wox remove " + " ".join(p for p in pkgs if "nvidia" in p))
        else:
            print(f"  - Switch to the recommended driver:  wox gpu install   (needs a package repo)")
    if any(g["vendor"] != 0x10DE for g in found):
        print("  - Hybrid laptop: the desktop runs on the integrated GPU. Start a game or app on\n"
              "    the NVIDIA card with:  prime-run <app>   (Steam: prime-run %command%)")
    if rec != "new" and installed("cuda", "ai-center"):
        print("  - The AI Center (CUDA 13) needs an RTX 20 / GTX 16 or newer card; this one is too old.")
    print("  - Black screen after an update: in the boot menu press 'e', add  nomodeset  to the\n"
          "    linux line, boot, then run  wox gpu  and  wox gpu install.\n"
          "  - Driver check:  nvidia-smi   Module build:  dkms status   Log:  journalctl -b -k | grep -i nvidia\n"
          "  - Suspend/resume problems: the nvidia-suspend, -hibernate and -resume services must be enabled.\n"
          "  - 32-bit games (Steam) need lib32-nvidia-utils (legacy: lib32-nvidia-580xx-utils).")
    return 0


COMMANDS = {
    "why": cmd_why, "diagnose": cmd_why,
    "gpu": cmd_gpu,
    "install": cmd_install, "i": cmd_install,
    "remove": cmd_remove, "rm": cmd_remove,
    "update": cmd_update, "up": cmd_update,
    "search": cmd_search, "s": cmd_search,
    "info": cmd_info,
    "list": cmd_list,
    "clean": cmd_clean,
}


HELP = """wox - WiamOX terminal helper

Packages:
  wox install <pkg...>   install packages      (wox i)   sudo pacman -Sy
  wox remove <pkg...>    remove with unused deps (wox rm) sudo pacman -Rns
  wox update             update the whole system (wox up) sudo pacman -Syu
  wox search <term>      search the repos       (wox s)   pacman -Ss
  wox info <pkg...>      show package details             pacman -Qi / -Si
  wox list               explicitly installed packages    pacman -Qe
  wox clean              remove orphaned dependencies     pacman -Rns $(pacman -Qdtq)

Hardware:
  wox gpu                graphics cards, recommended/installed driver, tips
  wox gpu install        install the right NVIDIA driver (auto, new or legacy)

Errors:
  wox why            explain the last failed command (alias: why, wox diagnose)
  wox why -p         paste an error text instead
  some-cmd 2>&1 | wox why     explain piped output
  (wox why needs the local AI: start the AI Center and the llama.cpp server first.)"""


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(HELP)
        return 0
    if argv[1] in COMMANDS:
        return COMMANDS[argv[1]](argv[2:])
    print(f"wox: unknown command '{argv[1]}'\n\n{HELP}")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
