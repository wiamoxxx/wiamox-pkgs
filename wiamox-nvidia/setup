#!/bin/bash
# wiamox-nvidia setup: install the NVIDIA driver branch that fits this machine.
#
#   setup installer                  Calamares step in the new system, offline
#                                    [wiamox] repo; mode from the force-* markers
#   setup install [auto|new|legacy]  later, on an installed system (needs a repo)
#
# The card decides (wox gpu --recommend: new | legacy | nouveau | none). A
# forced branch wins unless it cannot drive the card (615 on Pascal, any
# NVIDIA driver on Kepler): installing it would leave a black screen.
# Never stops the installation: problems go to the log and the state file,
# which `wox gpu` shows.
set -u

ROOT=${WIAMOX_NVIDIA_ROOT:-}            # tests only
SHARE=$ROOT/usr/share/wiamox-nvidia
STATE=$ROOT/var/lib/wiamox-nvidia/state
LOG=$ROOT/var/log/wiamox-nvidia.log
MKINITCPIO_CONF=$ROOT/etc/mkinitcpio.conf
LIVE_OVERRIDE=$ROOT/etc/modprobe.d/nvidia-utils.conf

mkdir -p "${STATE%/*}" "${LOG%/*}"
log() { echo "[wiamox-nvidia] $*" | tee -a "$LOG"; }
warnings=()
warn() { warnings+=("$*"); log "WARNING: $*"; }

list() { grep -v -E '^[[:space:]]*(#|$)' "$SHARE/$1.packages"; }
# installed subset of the given package names
have() { pacman -Qq "$@" 2>/dev/null; }

case ${1:-} in
  installer)
    mode=auto
    if [[ -e $SHARE/force-new && -e $SHARE/force-legacy ]]; then
      warn "both 'force' options were ticked; detecting the card instead"
    elif [[ -e $SHARE/force-new ]]; then
      mode=new
    elif [[ -e $SHARE/force-legacy ]]; then
      mode=legacy
    fi
    ;;
  install)
    mode=${2:-auto}
    [[ $mode == auto || $mode == new || $mode == legacy ]] ||
      { echo "usage: ${0##*/} install [auto|new|legacy]" >&2; exit 2; }
    (( EUID == 0 )) || { echo "${0##*/}: run as root (sudo)" >&2; exit 1; }
    ;;
  *)
    echo "usage: ${0##*/} installer | install [auto|new|legacy]" >&2
    exit 2
    ;;
esac

rec=$(wox gpu --recommend 2>/dev/null) || rec=none
log "$(date '+%F %T') card: $rec, mode: $mode"

want=$rec
case $mode in
  new)
    case $rec in
      legacy)  warn "the new 615 driver was forced, but it cannot drive this card (Maxwell/Pascal/Volta): using the legacy 580 driver"; want=legacy ;;
      nouveau) warn "this card is older than Maxwell; no NVIDIA driver supports it: keeping nouveau"; want=nouveau ;;
      *)       want=new ;;
    esac ;;
  legacy)
    case $rec in
      nouveau) warn "this card is older than Maxwell; no NVIDIA driver supports it: keeping nouveau"; want=nouveau ;;
      *)       want=legacy ;;
    esac ;;
esac

# Swap to one branch: remove what only the other branch has (pacman would
# otherwise stop on the conflicts), then install this branch's list.
swap_to() {
  local target=$1 other=$2 p
  local -A keep=()
  local -a pkgs others gone=()
  mapfile -t pkgs < <(list "$target")
  mapfile -t others < <(list "$other")
  for p in "${pkgs[@]}"; do keep[$p]=1; done
  for p in $(have "${others[@]}"); do
    [[ -n ${keep[$p]:-} ]] || gone+=("$p")
  done
  if (( ${#gone[@]} )); then
    log "removing ${gone[*]}"
    pacman -Rdd --noconfirm "${gone[@]}" >>"$LOG" 2>&1 || warn "could not remove ${gone[*]}"
  fi
  log "installing the $target driver: ${pkgs[*]}"
  if ! pacman -S --needed --noconfirm "${pkgs[@]}" >>"$LOG" 2>&1; then
    warn "installing the $target driver failed (see $LOG)"
    return 1
  fi
}

# No NVIDIA driver wanted: remove every package of both lists that nothing
# else needs (cuda keeps opencl-nvidia, for example). Dependents go first,
# so retry until nothing more can be removed.
remove_all() {
  local -a all left
  mapfile -t all < <({ list new; list legacy; } | sort -u)
  mapfile -t left < <(have "${all[@]}")
  (( ${#left[@]} )) || return 1     # nothing to remove
  log "no NVIDIA driver for this machine; removing ${left[*]}"
  pacman -Rns --noconfirm "${left[@]}" >>"$LOG" 2>&1 && return 0
  local p progress=1
  while (( progress )); do
    progress=0
    for p in $(have "${left[@]}"); do
      pacman -Rns --noconfirm "$p" >>"$LOG" 2>&1 && progress=1
    done
  done
  mapfile -t left < <(have "${left[@]}")
  (( ${#left[@]} == 0 )) || log "kept (needed by other packages): ${left[*]}"
}

# The live ISO lets nouveau load (its boot menu picks the driver); an
# installed system follows nvidia-utils, which blacklists nouveau.
if [[ -f $LIVE_OVERRIDE ]] && grep -q 'WiamOX live' "$LIVE_OVERRIDE"; then
  rm -f "$LIVE_OVERRIDE"
fi

changed=0
case $want in
  new)    swap_to new legacy && changed=1 ;;
  legacy) swap_to legacy new && changed=1 ;;
  *)      remove_all && changed=1 ;;
esac

if [[ $want == new || $want == legacy ]] && (( changed )); then
  # Suspend/resume keep the video memory; without them the desktop can
  # come back black or frozen.
  systemctl enable nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service >>"$LOG" 2>&1 ||
    warn "could not enable the nvidia suspend/resume services"
  # Keep nouveau out of the initramfs (Arch wiki: drop the kms hook).
  if [[ -f $MKINITCPIO_CONF ]] && grep -qE '^HOOKS=.*[( ]kms[ )]' "$MKINITCPIO_CONF"; then
    sed -i -E '/^HOOKS=/ s/([( ])kms /\1/; /^HOOKS=/ s/ kms\)/)/' "$MKINITCPIO_CONF"
    log "removed the kms hook from mkinitcpio.conf"
  fi
fi

if [[ $want != new && -n $(have cuda ai-center) ]]; then
  warn "the AI Center (CUDA 13) needs an RTX 20 / GTX 16 or newer card; it will not use this GPU"
fi

if (( changed )); then
  mkinitcpio -P >>"$LOG" 2>&1 || warn "mkinitcpio -P failed (see $LOG)"
fi

{
  echo "$(date '+%F %T') card: $rec, mode: $mode, driver: $want"
  for w in "${warnings[@]}"; do echo "warning: $w"; done
} >"$STATE"
log "done: $want"
exit 0
