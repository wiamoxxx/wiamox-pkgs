# (with all dependencies) into the offline [wiamox] repo.
nvidia-open-dkms
nvidia-utils
lib32-nvidia-utils
opencl-nvidia
nvidia-settings
libva-nvidia-driver
nvidia-prime
egl-wayland
dkms
linux-headers
