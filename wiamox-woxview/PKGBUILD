# Maintainer: Wiam Khader <Wiam@wiamox.com>
pkgname=wiamox-woxview
pkgver=1.0.0
pkgrel=3
pkgdesc="WiamOX Viewer — offline image viewing, quick editing and printing by Wiam Khader"
arch=('x86_64')
url='https://github.com/wiamoxxx/woxview'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-svg' 'qt6-wayland'
         'qt6-imageformats' 'kimageformats' 'libheif' 'libavif' 'libjxl'
         'openjpeg2' 'exiv2' 'libraw' 'libtiff' 'opencv' 'zlib')
makedepends=('cmake' 'ninja' 'qt6-tools' 'python' 'librsvg')
checkdepends=('gtest')
optdepends=('cups: configure local printer queues for physical printing')
options=('!lto')

prepare() {
  local viewer_src=${WIAMOX_VIEWER_SRC:-$startdir/../../woxview}
  [[ -f "$viewer_src/UPSTREAM.md" && -f "$viewer_src/ImageLounge/CMakeLists.txt" ]] || {
    error "WiamOX Viewer source missing: clone wiamoxxx/woxview next to wiamox-pkgs, or set WIAMOX_VIEWER_SRC."
    return 1
  }
  mkdir -p "$srcdir/woxview"
  bsdtar --exclude=.git --exclude='./build*' -cf - -C "$viewer_src" . |
    bsdtar -xf - -C "$srcdir/woxview"
}

build() {
  # Generic x86-64; never inherit CachyOS -march=native.
  export CFLAGS='-march=x86-64 -mtune=generic -O2 -pipe'
  export CXXFLAGS="$CFLAGS"
  cmake -S "$srcdir/woxview/ImageLounge" -B "$srcdir/build" -G Ninja \
    -DQT_VERSION_MAJOR=6 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_PLUGINS=ON -DENABLE_PAINT=ON -DENABLE_TRANSFORM=ON -DENABLE_PAGE=ON \
    -DENABLE_FAKE_MINIATURES=OFF -DENABLE_COMPOSITE=OFF -DENABLE_SIMPLE=OFF \
    -DENABLE_TESTING=ON -DENABLE_TRANSLATIONS=ON -DENABLE_QUAZIP=OFF
  cmake --build "$srcdir/build" --parallel "${WIAMOX_VIEWER_JOBS:-3}"
}

check() {
  python "$srcdir/woxview/scripts/check-offline.py" "$srcdir/build/libwoxviewCore.so"
  cmake --build "$srcdir/build" --target core_tests viewer_tests --parallel "${WIAMOX_VIEWER_JOBS:-3}"
  QT_QPA_PLATFORM=offscreen ctest --test-dir "$srcdir/build" --output-on-failure
  local version
  version=$(QT_QPA_PLATFORM=offscreen "$srcdir/build/woxview" --version)
  [[ $version == "WiamOX Viewer $pkgver" ]]
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    rsvg-convert -w "$size" -h "$size" "$srcdir/woxview/ImageLounge/nomacs.svg" \
      -o "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/com.wiamox.woxview.png"
  done
  for doc in README.md UPSTREAM.md PACKAGING.md; do
    install -Dm644 "$srcdir/woxview/$doc" "$pkgdir/usr/share/doc/$pkgname/$doc"
  done
  install -Dm644 "$srcdir/woxview/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/share/licenses/$pkgname/third-party"
  cp -a "$srcdir/woxview/ImageLounge/license/." "$pkgdir/usr/share/licenses/$pkgname/third-party/"
}
