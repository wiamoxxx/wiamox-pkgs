# CONFIG_DRM_AST is not set
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_HYPERV=m
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=m
CONFIG_DRM_ACCEL_AMDXDNA=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DMABUF_HEAPS=y
