# CONFIG_INPUT_JOYDEV is not set

# ==================== I2C / pinctrl / LPSS (touchpads!) ====================
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_I801=m
CONFIG_I2C_PIIX4=m
