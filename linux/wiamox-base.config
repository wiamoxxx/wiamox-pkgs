CONFIG_PINCTRL_LEWISBURG=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_INTEL_IDMA64=m
CONFIG_DW_DMAC=m
CONFIG_DW_DMAC_PCI=y
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_HDCP=m
CONFIG_INTEL_MEI_PXP=m
CONFIG_INTEL_MEI_GSC=m

# ==================== Platform (laptop vendors, AMD/Intel PM) ====================
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_AMD_PMC=m
CONFIG_TEE=m
CONFIG_AMDTEE=m
CONFIG_AMD_PMF=m
# amdgpu <-> MediaTek WiFi band interference mitigation
CONFIG_AMD_WBRF=y
CONFIG_AMD_HSMP_ACPI=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_INTEL_SPEED_SELECT_INTERFACE=m
CONFIG_INTEL_UNCORE_FREQ_CONTROL=m
CONFIG_THINKPAD_ACPI=m
CONFIG_IDEAPAD_LAPTOP=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_WMI=m
CONFIG_DELL_WMI_PRIVACY=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=m
CONFIG_ACER_WMI=m
CONFIG_MSI_WMI=m
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_SENSORS_SURFACE_FAN=m
CONFIG_SENSORS_SURFACE_TEMP=m
# CONFIG_CHROME_PLATFORMS is not set

# ==================== Cameras (UVC + Intel IPU3/6/7 + AMD ISP4 laptop cams) ====================
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
CONFIG_VIDEO_INTEL_IPU6=m
# Skylake/Kaby Lake (Surface) cameras
CONFIG_VIDEO_IPU3_CIO2=m
# Intel Visual Sensing Controller in front of many IPU6 cameras
CONFIG_INTEL_VSC=m
# Lunar Lake (IPU7, staging) and AMD Strix (ISP4) cameras
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_INTEL_IPU7=m
CONFIG_VIDEO_AMD_ISP4_CAPTURE=m
CONFIG_I2C_DESIGNWARE_AMDISP=m
CONFIG_IPU_BRIDGE=m
CONFIG_INTEL_SKL_INT3472=m
CONFIG_VIDEO_OV01A10=m
CONFIG_VIDEO_OV02C10=m
CONFIG_VIDEO_OV02E10=m
CONFIG_VIDEO_OV08X40=m
CONFIG_VIDEO_OV13B10=m
CONFIG_VIDEO_OV2740=m
CONFIG_VIDEO_OV5675=m
CONFIG_VIDEO_OV8856=m
CONFIG_VIDEO_HI556=m
CONFIG_VIDEO_HI846=m
CONFIG_VIDEO_HI847=m
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# platform media: only for AMD ISP4 (the ARM SoC drivers in there need their ARCH_*)
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
# CONFIG_MEDIA_TEST_SUPPORT is not set

# ==================== Virtualization (host + guest) ====================
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HID_HYPERV_MOUSE=m
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_MMIO=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_VIRT_DRIVERS=y
CONFIG_VBOXGUEST=m
CONFIG_VBOXSF_FS=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_BALLOON=m
CONFIG_VMWARE_PVSCSI=m
CONFIG_SCSI_VIRTIO=m
# CONFIG_XEN is not set

# ==================== Crypto (HW accelerated) ====================
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CHACHA20POLY1305=m
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_DEV_CCP=y
# CONFIG_CRYPTO_DEV_QAT is not set

# ==================== Misc ====================
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_TRIGGERS=y
CONFIG_NEW_LEDS=y
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=m
CONFIG_SP5100_TCO=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_CHECKPOINT_RESTORE=y
# CONFIG_AGP is not set
# CONFIG_HW_RANDOM_VIA is not set
# CONFIG_X86_MPPARSE is not set
# PC speaker beeps
# CONFIG_PCSPKR_PLATFORM is not set
CONFIG_EXPERT=y
