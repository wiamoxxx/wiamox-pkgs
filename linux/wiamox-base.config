# ==================== Ethernet (desktop/laptop NICs) ====================
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_AQTION=m
CONFIG_TIGON3=m
CONFIG_E1000=m
# 10/25/100G workstation and homelab NICs
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
# legacy NICs pulled in by x86_64_defconfig
# CONFIG_NET_TULIP is not set
# CONFIG_8139TOO is not set
# CONFIG_E100 is not set
# CONFIG_SKY2 is not set
# CONFIG_FORCEDETH is not set
CONFIG_VIRTIO_NET=m
CONFIG_VMXNET3=m
CONFIG_HYPERV_NET=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_IPHETH=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_NET_AQC111=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
CONFIG_USB_NET_SMSC75XX=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_DM9601=m
CONFIG_USB_NET_SR9700=m
CONFIG_USB_SIERRA_NET=m
CONFIG_WWAN=m
CONFIG_MHI_WWAN_CTRL=m
CONFIG_MHI_WWAN_MBIM=m
CONFIG_IOSM=m
CONFIG_MTK_T7XX=m

# ==================== Wireless / Bluetooth ====================
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y
CONFIG_RFKILL=m
CONFIG_RFKILL_INPUT=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
# pre-2014 Intel cards (6000/2000/1000 series)
# CONFIG_IWLDVM is not set
CONFIG_ATH9K_PCI=y
# AR9271 / AR7010 USB dongles
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_RTW88_PCI=m
CONFIG_RTW89_PCI=m
CONFIG_RTW89_8922DE=m
CONFIG_MT7996E=m
CONFIG_MT7615E=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_SDIO=y
# Marvell 88W8897 (Surface Pro 4-7, Surface Laptop/Book); libertas stays off
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_PCIE=m
CONFIG_MWIFIEX_USB=m
# CONFIG_LIBERTAS is not set
# CONFIG_LIBERTAS_THINFIRM is not set
# pre-2013 Broadcom (BCM43xx b43, BCM4313 brcmsmac)
# CONFIG_BRCMSMAC is not set
# CONFIG_B43 is not set
# legacy wifi off
# CONFIG_RTLWIFI_DEBUG is not set
# CONFIG_ATH10K_DEBUG is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_IWLEGACY is not set
# CONFIG_ATH5K is not set
# CONFIG_ATH6KL is not set
# CONFIG_AR5523 is not set
# CONFIG_CARL9170 is not set
# CONFIG_WIL6210 is not set
# CONFIG_WCN36XX is not set
# CONFIG_B43LEGACY is not set
# CONFIG_RTL8180 is not set
# CONFIG_RTL8187 is not set
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_LEDS=y
CONFIG_BT_MSFTEXT=y
CONFIG_BT_AOSPEXT=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_INTEL_PCIE=m
CONFIG_BT_HCIVHCI=m

# ==================== USB / Thunderbolt / Type-C ====================
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
# CONFIG_USB_UHCI_HCD is not set
CONFIG_USB4=m
CONFIG_USB4_NET=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_USB_ACM=m
CONFIG_USB_PRINTER=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USBIP_CORE=m
CONFIG_USB_ROLE_SWITCH=m
# CONFIG_PCCARD is not set
# CONFIG_PARPORT is not set
# CONFIG_FIREWIRE is not set
# CONFIG_EISA is not set
# CONFIG_BLK_DEV_FD is not set

# ==================== Input / HID / sensors ====================
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_MISC=y
# CONFIG_INPUT_PCSPKR is not set
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=m
