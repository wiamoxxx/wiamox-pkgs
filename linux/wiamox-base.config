#
# WiamOX kernel configuration fragment
# Created by Wiam Khader for WiamOX (Arch-based)
# Target: Linux 7.3.x vanilla, x86_64, AMD + Intel PCs/laptops (~2016+:
#         Intel Skylake / AMD Zen and newer; generic x86-64, no -march)
# Priorities: desktop responsiveness & performance > size/memory.
# No legacy drivers or filesystems; WiFi is kept broad on purpose.
# Apply on top of x86_64_defconfig via scripts/kconfig/merge_config.sh
#

# ==================== Identity / branding ====================
CONFIG_LOCALVERSION="-wiamox"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="wiamox"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=m

# ==================== Compiler / build ====================
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
# CONFIG_X86_NATIVE_CPU is not set
CONFIG_KERNEL_ZSTD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set

# ==================== CPU: AMD + Intel only ====================
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set
CONFIG_NR_CPUS=512
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_X86_X2APIC=y
# AMD/Intel SoC platform devices (I2C/GPIO/UART behind laptop touchpads)
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_CPU_RESCTRL=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_MICROCODE=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=y
CONFIG_PERF_EVENTS_INTEL_RAPL=y
CONFIG_PERF_EVENTS_INTEL_CSTATE=y
CONFIG_PERF_EVENTS_AMD_POWER=y
CONFIG_PERF_EVENTS_AMD_UNCORE=y
CONFIG_PERF_EVENTS_AMD_BRS=y
CONFIG_NUMA=y
CONFIG_AMD_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_IA32_EMULATION=y
# CONFIG_X86_X32_ABI is not set
CONFIG_X86_SGX=y
CONFIG_X86_INTEL_TSX_MODE_AUTO=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y
# CONFIG_EFI_MIXED is not set
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_DMI_SYSFS=y
CONFIG_DMIID=y

# ==================== Scheduler / latency (desktop responsiveness) ====================
# Full preemption by default; PREEMPT_DYNAMIC allows preempt=lazy|voluntary|none
# on the kernel command line without a rebuild.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
CONFIG_PREEMPT_DYNAMIC=y
# CONFIG_PREEMPT_RT is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_HRTICK=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_CLASS_EXT=y
# CONFIG_SCHED_CORE is not set
CONFIG_SCHED_CACHE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_PSI=y
# CONFIG_SCHEDSTATS is not set
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
# CONFIG_RCU_LAZY is not set
CONFIG_IRQ_TIME_ACCOUNTING=y

# ==================== CPU frequency / power (balanced, power-profiles-daemon switches) ====================
# amd-pstate / intel_pstate run in active (EPP) mode: clocks ramp instantly,
# PPD picks Performance / Balanced / Power saver. schedutil only matters for
# CPUs without CPPC/HWP (acpi-cpufreq fallback, e.g. Zen 1).
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=m
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=m
CONFIG_CPU_FREQ_GOV_USERSPACE=m
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
# CONFIG_X86_AMD_PSTATE_UT is not set
CONFIG_X86_ACPI_CPUFREQ=m
# CONFIG_X86_AMD_FREQ_SENSITIVITY is not set
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CPU_IDLE_GOV_HALTPOLL=y
CONFIG_INTEL_IDLE=y
# favoured cores / hybrid scheduling hints
CONFIG_INTEL_TURBO_MAX_3=y
CONFIG_AMD_HFI=y
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_ACPI_TAD=m
CONFIG_ACPI_WMI=m
CONFIG_ACPI_PRMT=y
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_ACPI_DPTF=y
CONFIG_INT3406_THERMAL=m
CONFIG_ACPI_FPDT=y
CONFIG_ACPI_HMAT=y
CONFIG_ACPI_PCI_SLOT=y
CONFIG_ACPI_SBS=m
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
# CONFIG_PM_AUTOSLEEP is not set
CONFIG_ENERGY_MODEL=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_IDLE_INJECT=y
CONFIG_THERMAL=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_INTEL_POWERCLAMP=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_TCC_COOLING=m
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_PCH_THERMAL=m
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_SENSORS_IT87=m
CONFIG_SENSORS_ASUS_EC=m
CONFIG_SENSORS_ASUS_WMI=m
CONFIG_SENSORS_DRIVETEMP=m
CONFIG_SENSORS_ACPI_POWER=m
CONFIG_SENSORS_NCT6683=m
CONFIG_SENSORS_F71882FG=m
CONFIG_SENSORS_DELL_SMM=m
CONFIG_SENSORS_HP_WMI=m
CONFIG_SENSORS_LENOVO_EC=m
CONFIG_SENSORS_APPLESMC=m
CONFIG_SENSORS_GPD=m
CONFIG_SENSORS_JC42=m
CONFIG_SENSORS_SPD5118=m
# USB/AIO coolers and fan controllers
CONFIG_SENSORS_NZXT_KRAKEN2=m
CONFIG_SENSORS_NZXT_KRAKEN3=m
CONFIG_SENSORS_NZXT_SMART2=m
CONFIG_SENSORS_CORSAIR_CPRO=m
CONFIG_SENSORS_CORSAIR_PSU=m
CONFIG_SENSORS_AQUACOMPUTER_D5NEXT=m
CONFIG_SENSORS_GIGABYTE_WATERFORCE=m
CONFIG_SENSORS_ASUS_ROG_RYUJIN=m
CONFIG_SENSORS_ARCTIC_FAN_CONTROLLER=m
CONFIG_HWMON=y

# ==================== Memory management ====================
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_HUGETLBFS=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_KSM=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_HMM_MIRROR=y
CONFIG_MEMCG=y
CONFIG_USERFAULTFD=y
CONFIG_PER_VMA_LOCK=y
CONFIG_ANON_VMA_NAME=y
# faster boot on machines with a lot of RAM
CONFIG_DEFERRED_STRUCT_PAGE_INIT=y
# performance over hardening knobs that cost measurable throughput
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# ==================== Debug overhead off ====================
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_KASAN is not set
# CONFIG_KFENCE is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_DETECT_HUNG_TASK is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_PANIC_TIMEOUT=0
CONFIG_MAGIC_SYSRQ=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_BPF_EVENTS=y

# ==================== BPF / systemd / containers ====================
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_LSM=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_DMEM=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_TIME_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_FANOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_APPARMOR=y
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
CONFIG_KEYS=y
CONFIG_ENCRYPTED_KEYS=m
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_TCG_TIS_SPI=m
CONFIG_TCG_TIS_I2C=m
CONFIG_HW_RANDOM_TPM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_WATCH_QUEUE=y
CONFIG_IO_URING=y
CONFIG_NTSYNC=m
# CONFIG_USER_EVENTS is not set

# ==================== Block / storage ====================
CONFIG_BLK_DEV_NVME=y
# CONFIG_NVME_MULTIPATH is not set
CONFIG_NVME_HWMON=y
# readable NVMe status codes in dmesg
CONFIG_NVME_VERBOSE_ERRORS=y
CONFIG_VMD=y
# self-encrypting drives (sedutil), zoned SMR HDDs / ZNS NVMe
CONFIG_BLK_SED_OPAL=y
CONFIG_BLK_DEV_ZONED=y
# PCIe: hotplug (Thunderbolt/USB4 docks, eGPU), error reporting, PTM (i225/i226), SR-IOV
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_PCIEAER=y
CONFIG_PCIE_PTM=y
CONFIG_PCI_IOV=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
# CONFIG_ATA_PIIX is not set
# CONFIG_PATA_OLD_PIIX is not set
# CONFIG_ATA_SFF is not set
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=m
CONFIG_CHR_DEV_SG=m
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_MIRROR=m
CONFIG_DM_RAID=m
CONFIG_DM_VERITY=m
CONFIG_DM_INTEGRITY=m
CONFIG_MD=y
CONFIG_BLK_DEV_MD=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MMC_REALTEK_USB=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MISC_RTSX_USB=m
# CONFIG_MEMSTICK is not set
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m

# ==================== Filesystems ====================
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
# HFS+: read Mac drives from the rescue ISO
CONFIG_HFSPLUS_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=m
CONFIG_EROFS_FS=m
CONFIG_FUSE_FS=m
CONFIG_CUSE=m
CONFIG_VIRTIO_FS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
# 9p: shared folders in QEMU VMs (defconfig builds it in)
CONFIG_NET_9P=m
CONFIG_9P_FS=m
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_QUOTA=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_DEFAULT="utf8"
# legacy filesystems off (ext4 still mounts ext2/ext3; bcachefs left mainline)
# CONFIG_EXT2_FS is not set
CONFIG_EXT4_USE_FOR_EXT2=y
# CONFIG_JFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_MINIX_FS is not set
# CONFIG_UFS_FS is not set
# CONFIG_BEFS_FS is not set
# CONFIG_BFS_FS is not set
# CONFIG_EFS_FS is not set
# CONFIG_ADFS_FS is not set
# CONFIG_AFFS_FS is not set
# CONFIG_HPFS_FS is not set
# CONFIG_OMFS_FS is not set
# CONFIG_QNX4FS_FS is not set
# CONFIG_QNX6FS_FS is not set
# CONFIG_VXFS_FS is not set
# CONFIG_CRAMFS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_ORANGEFS_FS is not set
# CONFIG_CODA_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set

